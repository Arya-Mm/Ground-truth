    Node2:
      DependencyIndex: 2
      LevelID: 0
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |-
            // GroundTruth holographic rim glow: fresnel-brightened silhouette edges +
            // a slow emissive shimmer, layered on top of the authored baseColor/alpha
            // (script-driven proximity fade / VERIFY tween keep writing baseColor as before).
            input_vec4 colorInput1;
            output_vec4 result;

            void main()
            {
            	vec3 n = normalize(system.getSurfaceNormalWorldSpace());
            	vec3 viewDir = normalize(system.getCameraPosition() - system.getSurfacePositionWorldSpace());
            	float ndotv = clamp(dot(n, viewDir), 0.0, 1.0);
            	float fresnel = pow(1.0 - ndotv, 2.5);

            	float shimmer = 0.5 + 0.5 * sin(system.getTimeElapsed() * 1.2);
            	float glow = fresnel * (1.4 + 0.6 * shimmer);

            	vec3 rgb = colorInput1.rgb + colorInput1.rgb * glow;
            	float alpha = clamp(colorInput1.a + colorInput1.a * fresnel * 1.1, 0.0, 1.0);
            	result = vec4(rgb, alpha);
            }
        CustomCodeNodeAsset:
          ClassType1: REFUID
          String: ""
        Description:
          ClassType1: TEXT
          String: ""
        Examples:
          ItemIndex: 0
          ItemList: "Custom : Input/Output/Global Types : Extra Functions : Procedural Execution : Lighting Loop : System Built-In Values/Functions"
        ID:
          Variable: 0
        Locked:
          Variable: false
        Stage:
          ItemIndex: 1
          ItemList: "Vertex : Pixel"
        Title:
          String: Custom Code
        UseExternalFile:
          Variable: false
        colorInput1:
          Connection0:
            NodeLevelID: 1
            PortID: Output
          Variable: [0.0, 0.0, 0.0, 0.0]
        ngs_Height:
          Variable: 400
        ngs_Version:
          String: 0.1.0
        result:
          IOType: 1
          Variable: [0.0, 0.0, 0.0, 0.0]
      PositionX: -59
      PositionY: 91
      TemplateID: node_util_custom
      TemplateVersionMinor: 2
      Title1: Custom Code
